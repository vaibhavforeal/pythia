rules_version = '2';

// ===============================================================
// Pythia — Firestore Security Rules
// ===============================================================
//
// SCOPE OF THIS FILE
//
// The Express server talks to Firestore with the Admin SDK, which bypasses
// these rules entirely. So everything here governs ONE thing: what the
// Android/web client is allowed to touch directly.
//
// The architecture is deliberately narrow — the client reads only its own
// documents, and anything involving another person goes through the server.
// That isn't a stylistic choice. Compatibility scores and the daily flow are
// DERIVED from two people's charts, and rules can only permit or deny a read,
// never transform it. Letting the client compute a score would mean letting it
// read the other person's birth date, time and place — at which point the data
// is on the device no matter what the UI chooses to display.
//
// Consequence: friendships, friend requests, blocks, invites, invite responses
// and device tokens have NO client access at all. They are absent from these
// rules on purpose, and the default-deny at the bottom covers them.
//
// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: the Firebase Auth uid
// Fields:
//   - uid            string    (required, immutable) — equals the document id
//   - displayName    string    (optional, 1..80) — shown to friends
//   - birth          map       (optional) — { name, year, month, day, hour,
//                              minute, lat, lon, tz }. Their own birth details.
//                              NEVER readable by another user.
//   - birthRole      string    (optional, 'groom'|'bride') — Guna Milan is
//                              directional, so the pairing needs a role
//   - soulId         string    (server-only) — shareable handle, frozen once set
//   - soulIdAt       timestamp (server-only)
//   - phone          string    (server-only) — mirrors Firebase Auth
//   - phoneVerified  bool      (server-only)
//   - streakCurrent  number    (server-only) — client-writable streaks are meaningless
//   - streakLongest  number    (server-only)
//   - streakLast     string    (server-only, YYYY-MM-DD in the USER's local time)
//   - streakDays     number    (server-only)
//   - createdAt      timestamp (immutable)
//
// Subcollection: users/{uid}/conversations  (client: READ ONLY)
// Document ID: generated
// Fields:
//   - title      string    (required, 1..200)
//   - chart      map       (required) — computed chart snapshot
//   - input      map       (optional) — raw birth input, to restore the form
//   - match      map       (optional) — compatibility result, if any
//   - messages   list      (required, <= 500 entries)
//   - createdAt  timestamp (required, immutable)
//   - updatedAt  timestamp (required)
//
// Server-only collections (no client access — see SCOPE above):
//   friendships, friendRequests, blocks, invites, inviteResponses, devices
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Fields only the server may ever write. Listed once so the create and
    // update rules can't drift apart.
    function serverOwnedFields() {
      return [
        'soulId', 'soulIdAt', 'phone', 'phoneVerified',
        'streakCurrent', 'streakLongest', 'streakLast', 'streakDays'
      ];
    }

    // True when the write touches none of the server-owned fields.
    // On update, a field is "touched" only if its value actually changes —
    // so a client sending the whole document back unmodified still passes.
    function leavesServerFieldsAlone() {
      return !incoming().diff(existing()).affectedKeys().hasAny(serverOwnedFields());
    }

    function setsNoServerFields() {
      return !incoming().keys().hasAny(serverOwnedFields());
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in incoming()) || (
        incoming()[field] is string &&
        incoming()[field].size() >= minLen &&
        incoming()[field].size() <= maxLen
      );
    }

    // Birth details: a map with the numeric fields the ephemeris needs. Values
    // are range-checked so a malformed write can't poison the chart the server
    // later computes from it.
    function isValidBirth() {
      return !('birth' in incoming()) || (
        incoming().birth is map &&
        incoming().birth.keys().hasAll(['year', 'month', 'day', 'hour', 'minute', 'lat', 'lon', 'tz']) &&
        incoming().birth.keys().hasOnly(['name', 'year', 'month', 'day', 'hour', 'minute', 'lat', 'lon', 'tz']) &&
        isValidOptionalBirthName() &&
        incoming().birth.year is int && incoming().birth.year >= 1900 && incoming().birth.year <= 2100 &&
        incoming().birth.month is int && incoming().birth.month >= 1 && incoming().birth.month <= 12 &&
        incoming().birth.day is int && incoming().birth.day >= 1 && incoming().birth.day <= 31 &&
        incoming().birth.hour is int && incoming().birth.hour >= 0 && incoming().birth.hour <= 23 &&
        incoming().birth.minute is int && incoming().birth.minute >= 0 && incoming().birth.minute <= 59 &&
        incoming().birth.lat is number && incoming().birth.lat >= -90 && incoming().birth.lat <= 90 &&
        incoming().birth.lon is number && incoming().birth.lon >= -180 && incoming().birth.lon <= 180 &&
        incoming().birth.tz is number && incoming().birth.tz >= -14 && incoming().birth.tz <= 14
      );
    }

    function isValidOptionalBirthName() {
      return !('name' in incoming().birth) || (
        incoming().birth.name is string && incoming().birth.name.size() <= 80
      );
    }

    function isValidBirthRole() {
      return !('birthRole' in incoming()) ||
        incoming().birthRole in ['groom', 'bride'];
    }

    // Validator function pattern — called from BOTH create and update.
    function isValidUser(userId) {
      return incoming().uid == userId
        && isValidOptionalString('displayName', 1, 80)
        && isValidBirth()
        && isValidBirthRole();
    }


    // ===============================================================
    // users/{userId}
    // ===============================================================
    match /users/{userId} {
      // Only ever your own document. There is no rule permitting a read of
      // somebody else's — which is what keeps birth data off other devices.
      allow get: if isOwner(userId);

      // No listing: a user has no reason to enumerate the collection, and
      // allowing it would leak the existence of every account.
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidUser(userId)
        && setsNoServerFields();

      allow update: if isOwner(userId)
        && isValidUser(userId)
        && leavesServerFieldsAlone();
        // No uid-unchanged check needed: isValidUser pins uid to the path and
        // isOwner pins the path to the token, so ownership can't move. Checking
        // against existing().uid would also lock the user out of a document the
        // server created without that field.

      // Account deletion runs server-side so the graph, invites and devices
      // are cleaned up with it; a bare document delete would orphan all of it.
      allow delete: if false;

      // ===============================================================
      // users/{userId}/conversations/{conversationId}
      // ===============================================================
      // Reads are direct so the list is fast and works offline. Writes go
      // through the server: `chart` is an arbitrarily large map and rules have
      // no document-size function, so a client-writable conversation is an
      // unbounded storage-abuse vector. The API already owns these writes.
      match /conversations/{conversationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ===============================================================
    // Default deny
    // ===============================================================
    //
    // Everything not matched above — friendships, friendRequests, blocks,
    // invites, inviteResponses, devices — is server-only by design. This also
    // catches any collection added later before its rules are written.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
